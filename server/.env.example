# ============================================================
# Smart Learning & Placement Preparation Portal
# Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env
# ============================================================

# --- Server Configuration ---
# Port on which the Express server will listen
PORT=5000

# --- Database Configuration ---
# MongoDB Atlas connection string
# Get yours at: https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# --- JWT (JSON Web Token) Configuration ---
# Secret key used to sign and verify JWT tokens
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Token expiration time (e.g., 7d = 7 days, 1h = 1 hour)
JWT_EXPIRE=7d

# --- Google Gemini AI Configuration ---
# API key for Google's Generative AI (Gemini) service
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Resend Email Configuration ---
# API key for Resend email service
# Get yours at: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# --- Client Configuration ---
# Frontend URL for CORS configuration and email links
CLIENT_URL=http://localhost:3000

# --- Environment ---
# Options: development, production, test
NODE_ENV=development
